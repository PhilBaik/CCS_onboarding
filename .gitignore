# macOS
.DS_Store

# Reference PDFs (TI documents; the README.md notes next to them are tracked)
*.pdf

# CCS build configuration folders (fully regenerated by the build)
CPU1_RAM/
CPU1_FLASH/
Debug/
Release/

# Build artifacts, in case they land outside a configuration folder
*.obj
*.out
*.map
*.d
*_linkInfo.xml
ccsObjs.opt

# clangd config (auto-generated by CCS, says "do not add to source-control") and index cache
.clangd

# Per-machine files that CCS generates inside each project (absolute install paths, AI helpers)
28379D_demo/**/.mcp.json
28379D_demo/**/.theia/
28379D_demo/**/.claude/
28379D_demo/**/CLAUDE.md
